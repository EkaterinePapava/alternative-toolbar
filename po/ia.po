#: ../alternative-toolbar.py:228 ../alternative-toolbar.py:231
msgid "Search"
msgstr "Cercar"

#: ../alternative-toolbar.py:238
msgid "Seek Backward"
msgstr "Recercar retro"

#: ../alternative-toolbar.py:241
msgid "Seek backward, in current track, by 5 seconds."
msgstr "Recercar retro, in tracia actual pro, 5 secundas"

#: ../alternative-toolbar.py:245
msgid "Seek Forward"
msgstr "Recercar avante"

#: ../alternative-toolbar.py:249
msgid "Seek forward, in current track, by 10 seconds."
msgstr "Recercar avante, in tracia actual pro, 10 secundas"

#: ../alternative-toolbar.py:261
msgid "Show Play-Controls Toolbar"
msgstr "Monstrar barra utensiles de reproduction o controlo"

#: ../alternative-toolbar.py:265
msgid "Show or hide the play-controls toolbar"
msgstr "Monstrar o celar le barra utensiles de reproduction o controlo"

#: ../alternative-toolbar.py:270
msgid "Show Source Toolbar"
msgstr "Monstrar barra utensiles fonte"

#: ../alternative-toolbar.py:273
msgid "Show or hide the source toolbar"
msgstr "Monstra o cela le barra utensiles fonte"

#. define .plugin text strings used for translation
#: ../alternative-toolbar.py:554
msgid "Alternative Toolbar"
msgstr "Barra utensiles alternative"

#: ../alternative-toolbar.py:557
msgid ""
"Replace the Rhythmbox large toolbar with a Client-Side Decorated or Compact "
"Toolbar which can be hidden"
msgstr ""
"Reimplacia le grande barra del instrumentos de Rhythmbox con un  Barra del "
"instrumento compacte, decorate del latere del cliente que pote esser celate"

#: ../alttoolbar_controller.py:156
msgid "View All"
msgstr "Vider toto"

#: ../alttoolbar_controller.py:533
msgid "Stations"
msgstr "Stationes"

#: ../alttoolbar_controller.py:562
msgid "Libre.fm"
msgstr "Libre.fm"

#: ../alttoolbar_controller.py:605
msgid "My Top Rated"
msgstr "Mi melior classificate"

#: ../alttoolbar_controller.py:609
msgid "Recently Added"
msgstr "Recentemente addite"

#: ../alttoolbar_controller.py:613
msgid "Recently Played"
msgstr "Recentemente  reproducite"

#: ../alttoolbar_controller.py:646
msgid "Podcasts"
msgstr "Podcasts"

#: ../alttoolbar_preferences.py:307
msgid "Restart"
msgstr "Reinitialisar"

#: ../alttoolbar_sidebar.py:81
msgid "Local collection"
msgstr "Collection local"

#: ../alttoolbar_sidebar.py:82
msgid "Online sources"
msgstr "Fontes on line"

#: ../alttoolbar_sidebar.py:83
msgid "Other sources"
msgstr "Altere fontes"

#: ../alttoolbar_sidebar.py:84
msgid "Playlists"
msgstr "Listas de reproduction"

#: ../alttoolbar_type.py:1469 ../ui/altlibrary.ui.h:1
msgid "Songs"
msgstr "Cantos"

#: ../alttoolbar_type.py:1475 ../alttoolbar_type.py:1559
#: ../ui/altpreferences.ui.h:28 ../ui/altlibrary.ui.h:2
msgid "Categories"
msgstr "Categorias"

#: ../alttoolbar_type.py:1543
msgid "Browse"
msgstr "Navigar"

#: ../alttoolbar_repeat.py:96 ../alttoolbar_repeat.py:193
msgid "Repeat all tracks"
msgstr "Repeter tote le tracias"

#: ../alttoolbar_repeat.py:98 ../alttoolbar_repeat.py:214
#: ../ui/alttoolbar.ui.h:4
msgid "Repeat the current track"
msgstr "Repeter le tracia actual"

#: ../ui/altpreferences.ui.h:1
msgid "Top"
msgstr "Alto"

#: ../ui/altpreferences.ui.h:2
msgid "Bottom"
msgstr "Basso"

#: ../ui/altpreferences.ui.h:3
msgid "Horizontal"
msgstr "Horizontal"

#: ../ui/altpreferences.ui.h:4
msgid "Vertical"
msgstr "Vertical"

#: ../ui/altpreferences.ui.h:5
msgid "Restart the player for the changes to take effect."
msgstr "Reinitialisar le reproductor proque le cambios ha effecto"

#: ../ui/altpreferences.ui.h:6
msgid "Toolbar:"
msgstr "Barra utensiles"

#: ../ui/altpreferences.ui.h:7
msgid ""
"Best suitable for desktop\n"
"environments like Gnome and Elementary."
msgstr ""
"Le plus convenibile pro ambientes\n"
"de scriptorio como GNOME e Elementary."

#: ../ui/altpreferences.ui.h:9
msgid "Modern"
msgstr "Moderne"

#: ../ui/altpreferences.ui.h:10
msgid "Use compact controls"
msgstr "Usar controlos compacte"

#: ../ui/altpreferences.ui.h:11
msgid ""
"Display the playback controls in the toolbar in visually compact style "
"instead of the standard rhythmbox style.\n"
"Always enabled for modern toolbar mode."
msgstr ""
"Monstrar le controlos de reproduction in le barra del instrumentos in stilo "
"visualmente compacte in vice que le stilo rhythmbox standard..\n"
"Sempre activate pro modo moderne del barra del instrumentos."

#: ../ui/altpreferences.ui.h:13
msgid "Show:"
msgstr "Monstrar:"

#: ../ui/altpreferences.ui.h:14
msgid "Album/genre/year for playing song"
msgstr "Album/genere/anno pro reproducer le canto"

#: ../ui/altpreferences.ui.h:15
msgid ""
"Display album/genre/year instead of song-artist-album.  Useful for those "
"desktop-environments where song-artist-album is already displayed in the "
"window title."
msgstr ""
"Monstrar album/genere/anno in vice que canto-artista-album. Utile pro ille "
"ambientes de scriptorio ubi canto-artista-album es jam monstrate in le "
"titulo de fenestra."

#: ../ui/altpreferences.ui.h:16
msgid "Tooltips for the playback controls"
msgstr "Consilios pro le controlos de reproduction"

#: ../ui/altpreferences.ui.h:17
msgid "Show or hide the tooltips for the playback controls."
msgstr "Monstra o cela le consilios pro le controlos de reproduction."

#: ../ui/altpreferences.ui.h:18
msgid "Volume control"
msgstr "Controlo de volumine"

#: ../ui/altpreferences.ui.h:19
msgid "Show or hide the volume control."
msgstr "Monstar o celar le controlo de volumine"

#: ../ui/altpreferences.ui.h:20
msgid "Playback controls"
msgstr "Controlos de reproduction"

#: ../ui/altpreferences.ui.h:21
msgid "Show or hide the playing controls on player startup."
msgstr ""
"Monstra o cela le controlos de reproduction al lanceamento initial del "
"reproductor."

#: ../ui/altpreferences.ui.h:22
msgid "Use:"
msgstr "Usar:"

#: ../ui/altpreferences.ui.h:23
msgid "Inline song/artist label"
msgstr "Etiquetta in linea de canto/artista"

#: ../ui/altpreferences.ui.h:24
msgid ""
"Display Song and Artist labels before the progress slider.  If not checked, "
"they are displayed above the progress slider."
msgstr ""
"Monstra etiquettas de canto e artista ante le cursor de progresso. Si non "
"marcate, illos es monstrate supra le cursor de progresso."

#: ../ui/altpreferences.ui.h:25
msgid "Enhanced sidebar"
msgstr "Barra lateral meliorate"

#: ../ui/altpreferences.ui.h:26
msgid ""
"Show or hide redesigned sidebar for the player. It features improved "
"symbolic icons, better sources organisation and ability to expand and "
"collapse categories."
msgstr ""
"Monstra o cela le barra lateral redesignate pro le jocator. Illo dispone de "
"icones symbolic meliorate, melior organisation de fontes e capacitate de "
"expander e collaber categorias."

#: ../ui/altpreferences.ui.h:27
msgid "Dark theme if available"
msgstr "Thema obscur si disponibile"

#: ../ui/alttoolbar.ui.h:1
msgid "Play the previous track"
msgstr "Reproducer le tracia precedente"

#: ../ui/alttoolbar.ui.h:2
msgid "Resume or pause the playback"
msgstr "Resumer o pausar le reproduction"

#: ../ui/alttoolbar.ui.h:3
msgid "Play the next track"
msgstr "Reproducer le tracia sequente"

#: ../ui/alttoolbar.ui.h:5
msgid "Play the tracks in random order"
msgstr "Reproducer le tracias in ordine aleatori"
