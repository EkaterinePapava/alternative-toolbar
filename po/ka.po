msgstr "ჰორიზონტალური"

#: ../ui/altpreferences.ui.h:4
msgid "Vertical"
msgstr "ვერტიკალური"

#: ../ui/altpreferences.ui.h:5
msgid "Restart the player for the changes to take effect."
msgstr "გადატვირთეთ დამკვრელი ცვლილებების ძალაში შესასვლელად."

#: ../ui/altpreferences.ui.h:6
msgid "Toolbar:"
msgstr "ხელსაწყოების პანელი:"

#: ../ui/altpreferences.ui.h:7
msgid ""
"Best suitable for desktop\n"
"environments like Gnome and Elementary."
msgstr ""
"საუკეთესოა ისეთი სამუშაო მაგიდებისთვის,\n"
"როგორიცაა GNOME და Elementary."

#: ../ui/altpreferences.ui.h:9
msgid "Modern"
msgstr "თანამედროვე"

#: ../ui/altpreferences.ui.h:10
msgid "Use compact controls"
msgstr "კომპაქტური კონტროლის ელემენტების გამოყენება"

#: ../ui/altpreferences.ui.h:11
msgid ""
"Display the playback controls in the toolbar in visually compact style "
"instead of the standard rhythmbox style.\n"
"Always enabled for modern toolbar mode."
msgstr ""
"გამოიტანეთ დაკვრის კონტროლის ელემენტები ხელსაწყოთა პანელი ვიზუალურად "
"კომპაქტურ სტილში სტანდარტული rhythmbox-ის სტილის მაგიერ.\n"
"თანამედროვე ხელსაწყოთა პანელის რეჟიმში ყოველთვის ჩართულია."

#: ../ui/altpreferences.ui.h:13
msgid "Show:"
msgstr "ჩვენება:"

#: ../ui/altpreferences.ui.h:14
msgid "Album/genre/year for playing song"
msgstr "ალბომი/ჟანრი/წელიწადი სიმღერისთვის, რომლის დაკვრაც მიმდინარეობს"

#: ../ui/altpreferences.ui.h:15
msgid ""
"Display album/genre/year instead of song-artist-album.  Useful for those "
"desktop-environments where song-artist-album is already displayed in the "
"window title."
msgstr ""
"ალბომი/ჟანრი/წლის ჩვენება სიმღერა-შემსრულებელი-ალბომის მაგიერ.  გამოსადეგია "
"იმ სამუშაო გარემოებისთვის, სადაც სიმღერა-შემსრულებელი-ალბომი უკვე "
"ნაჩვენებია ფანჯრის სათაურში."

#: ../ui/altpreferences.ui.h:16
msgid "Tooltips for the playback controls"
msgstr "მინიშნებები დაკვრის კონტროლის ელემენტებისთვის"

#: ../ui/altpreferences.ui.h:17
msgid "Show or hide the tooltips for the playback controls."
msgstr "დაკვრის კონტროლის ელემენტების მინიშნებების ჩვენება, ან დამალვა."

#: ../ui/altpreferences.ui.h:18
msgid "Volume control"
msgstr "ხმის კონტროლი"

#: ../ui/altpreferences.ui.h:19
msgid "Show or hide the volume control."
msgstr "ხმის კონტროლის ჩვენება, ან დამალვა."

#: ../ui/altpreferences.ui.h:20
msgid "Playback controls"
msgstr "დაკვრის კონტროლის ელემენტები"

#: ../ui/altpreferences.ui.h:21
msgid "Show or hide the playing controls on player startup."
msgstr ""
"დამკვრელის გაშვებისას დაკვრის კონტროლის ელემენტების ჩვენება, ან დამალვა."

#: ../ui/altpreferences.ui.h:22
msgid "Use:"
msgstr "გამოყენება:"

#: ../ui/altpreferences.ui.h:23
msgid "Inline song/artist label"
msgstr "ხაზშივე სიმღერის/შემსრულებლის ჭდე"

#: ../ui/altpreferences.ui.h:24
msgid ""
"Display Song and Artist labels before the progress slider.  If not checked, "
"they are displayed above the progress slider."
msgstr ""
"სიმღერისა და შემსრულებლის ჭდეების ჩვენება მიმდინარეობის ჩოჩიაზე.  თუ "
"ჩართული არა, ისინი მიმდინარეობის ჩოჩიას თავზე იქნება ნაჩვენები."

#: ../ui/altpreferences.ui.h:25
msgid "Enhanced sidebar"
msgstr "გაფართოებული გვერდითი პანელები"

#: ../ui/altpreferences.ui.h:26
msgid ""
"Show or hide redesigned sidebar for the player. It features improved "
"symbolic icons, better sources organisation and ability to expand and "
"collapse categories."
msgstr ""
"განახლებული გვერდითი პანელის ჩვენება, ან დამალვა დამკვრელიდან. მას აქვს "
"გაუმჯობესებული ხატულები, უკეთესი წყაროების ორგანიზაცია და შესაძლებლობა, "
"აკეცოს და ჩამოკეცოს კატეგორიები."

#: ../ui/altpreferences.ui.h:27
msgid "Dark theme if available"
msgstr "მუქი თემა, თუ ხელმისაწვდომია"

#: ../ui/alttoolbar.ui.h:1
msgid "Play the previous track"
msgstr "წინას დაკვრა"

#: ../ui/alttoolbar.ui.h:2
msgid "Resume or pause the playback"
msgstr "დაკვრის შეჩერება, ან გაგრძელება"

#: ../ui/alttoolbar.ui.h:3
msgid "Play the next track"
msgstr "შემდეგის დაკვრა"

#: ../ui/alttoolbar.ui.h:5
msgid "Play the tracks in random order"
msgstr "სიმღერების დაკვრა შემთხვევითი მიმდევრობით"
