msgstr "Son əlavə olunanlar"

#: ../alttoolbar_controller.py:613
msgid "Recently Played"
msgstr "Son ifa olunanlar"

#: ../alttoolbar_controller.py:646
msgid "Podcasts"
msgstr "Podkastlar"

#: ../alttoolbar_preferences.py:307
msgid "Restart"
msgstr "Yenidən başlat"

#: ../alttoolbar_sidebar.py:81
msgid "Local collection"
msgstr "Yerli yığın"

#: ../alttoolbar_sidebar.py:82
msgid "Online sources"
msgstr "Onlayn mənbələr"

#: ../alttoolbar_sidebar.py:83
msgid "Other sources"
msgstr "Digər mənbələr"

#: ../alttoolbar_sidebar.py:84
msgid "Playlists"
msgstr "Oynatma siyahıları"

#: ../alttoolbar_type.py:1469 ../ui/altlibrary.ui.h:1
msgid "Songs"
msgstr "Mahnılar"

#: ../alttoolbar_type.py:1475 ../alttoolbar_type.py:1559
#: ../ui/altpreferences.ui.h:28 ../ui/altlibrary.ui.h:2
msgid "Categories"
msgstr "Kateqoriyalar"

#: ../alttoolbar_type.py:1543
msgid "Browse"
msgstr "Gəz"

#: ../alttoolbar_repeat.py:96 ../alttoolbar_repeat.py:193
msgid "Repeat all tracks"
msgstr "Bütün trekləri təkrarla"

#: ../alttoolbar_repeat.py:98 ../alttoolbar_repeat.py:214
#: ../ui/alttoolbar.ui.h:4
msgid "Repeat the current track"
msgstr "Cari treki təkrarla"

#: ../ui/altpreferences.ui.h:1
msgid "Top"
msgstr "Yuxarı"

#: ../ui/altpreferences.ui.h:2
msgid "Bottom"
msgstr "Aşağı"

#: ../ui/altpreferences.ui.h:3
msgid "Horizontal"
msgstr "Üfüqi"

#: ../ui/altpreferences.ui.h:4
msgid "Vertical"
msgstr "Şaquli"

#: ../ui/altpreferences.ui.h:5
msgid "Restart the player for the changes to take effect."
msgstr "Dəyişikliklərin qüvvəyə minməsi üçün pleyeri yenidən başlat."

#: ../ui/altpreferences.ui.h:6
msgid "Toolbar:"
msgstr "Alət çubuğu:"

#: ../ui/altpreferences.ui.h:7
msgid ""
"Best suitable for desktop\n"
"environments like Gnome and Elementary."
msgstr "Gnome və Elementary kimi masaüstü mühitlər üçün ən uyğun seçimdir."

#: ../ui/altpreferences.ui.h:9
msgid "Modern"
msgstr "Müasir"

#: ../ui/altpreferences.ui.h:10
msgid "Use compact controls"
msgstr "Kompakt idarəetmələrdən istifadə et"

#: ../ui/altpreferences.ui.h:11
msgid ""
"Display the playback controls in the toolbar in visually compact style "
"instead of the standard rhythmbox style.\n"
"Always enabled for modern toolbar mode."
msgstr ""
"Oynatma idarəetmələrini standart Rhythmbox üslubu əvəzinə alət çubuğunda "
"vizual olaraq kompakt tərzdə göstər.\n"
"Bu, müasir alət çubuğu rejimi üçün həmişə aktiv olur."

#: ../ui/altpreferences.ui.h:13
msgid "Show:"
msgstr "Göstər:"

#: ../ui/altpreferences.ui.h:14
msgid "Album/genre/year for playing song"
msgstr "İfa olunan mahnı üçün albom/janr/il"

#: ../ui/altpreferences.ui.h:15
msgid ""
"Display album/genre/year instead of song-artist-album.  Useful for those "
"desktop-environments where song-artist-album is already displayed in the "
"window title."
msgstr ""
"Mahnı–ifaçı–albom əvəzinə albom/janr/ili göstər. Bu, artıq pəncərə "
"başlığında mahnı–ifaçı–albom məlumatları görünən masaüstü mühitlər üçün "
"faydalıdır."

#: ../ui/altpreferences.ui.h:16
msgid "Tooltips for the playback controls"
msgstr "Oynatma idarəetmələri üçün ipucları"

#: ../ui/altpreferences.ui.h:17
msgid "Show or hide the tooltips for the playback controls."
msgstr "Oynatma idarəetmələri üçün ipuclarını göstər və ya gizlət."

#: ../ui/altpreferences.ui.h:18
msgid "Volume control"
msgstr "Səs səviyyəsi idarəetməsi"

#: ../ui/altpreferences.ui.h:19
msgid "Show or hide the volume control."
msgstr "Səs səviyyəsi idarəetməsini göstər və ya gizlət."

#: ../ui/altpreferences.ui.h:20
msgid "Playback controls"
msgstr "Oynatma idarəetmələri"

#: ../ui/altpreferences.ui.h:21
msgid "Show or hide the playing controls on player startup."
msgstr "Pleyer başladıqda oynatma idarəetmələrini göstər və ya gizlət."

#: ../ui/altpreferences.ui.h:22
msgid "Use:"
msgstr "İstifadə et:"

#: ../ui/altpreferences.ui.h:23
msgid "Inline song/artist label"
msgstr "Sətiriçi mahnı/ifaçı etiketi"

#: ../ui/altpreferences.ui.h:24
msgid ""
"Display Song and Artist labels before the progress slider.  If not checked, "
"they are displayed above the progress slider."
msgstr ""
"Mahnı və ifaçı etiketlərini irəliləyiş sürüşdürgüsündən əvvəl göstər. "
"Seçilmədikdə, onlar sürüşdürgünün yuxarısında göstəriləcək."

#: ../ui/altpreferences.ui.h:25
msgid "Enhanced sidebar"
msgstr "Təkmilləşdirilmiş yan panel"

#: ../ui/altpreferences.ui.h:26
msgid ""
"Show or hide redesigned sidebar for the player. It features improved "
"symbolic icons, better sources organisation and ability to expand and "
"collapse categories."
msgstr ""
"Pleyer üçün yenidən tərtib edilmiş yan paneli göstər və ya gizlət. Bu "
"paneldə təkmilləşdirilmiş simvolik ikonlar, daha yaxşı mənbə təşkilatı və "
"kateqoriyaları genişləndirmək və yığmaq imkanı mövcuddur."

#: ../ui/altpreferences.ui.h:27
msgid "Dark theme if available"
msgstr "Əgər mümkündürsə, tünd mövzu"

#: ../ui/alttoolbar.ui.h:1
msgid "Play the previous track"
msgstr "Əvvəlki treki oxut"

#: ../ui/alttoolbar.ui.h:2
msgid "Resume or pause the playback"
msgstr "Oynatmanı davam etdir və ya fasilə ver"

#: ../ui/alttoolbar.ui.h:3
msgid "Play the next track"
msgstr "Növbəti treki oxut"

#: ../ui/alttoolbar.ui.h:5
msgid "Play the tracks in random order"
msgstr "Trekləri təsadüfi ardıcıllıqla oxut"
